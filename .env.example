# ---- تلگرام ----
# توکن ربات از @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# آیدی کانال (ربات باید ادمین باشه). پابلیک: @your_channel — پرایوت: -100xxxxxxxxxx
TELEGRAM_CHANNEL_ID=@your_channel

# لینک تلگرام پشتیبانی (دکمه زیر هر پست)
SUPPORT_TELEGRAM_URL=https://t.me/your_support_id

# اگه از داخل ایران اجرا می‌کنی و تلگرام مسدوده، آدرس پروکسی رو اینجا بذار
# مثال: socks5h://127.0.0.1:1080  یا  http://127.0.0.1:8080
# اگه از سرور خارجی اجرا می‌کنی، خالی بذار.
TELEGRAM_PROXY=

# ---- نحوه پست ----
# album  = همه عکس‌های آگهی به صورت آلبوم (دکمه‌ها در یک پیام کوچک زیر آلبوم میان،
#          چون تلگرام اجازه دکمه روی آلبوم رو نمیده)
# single = فقط یک عکس + کپشن + دکمه‌ها روی خود پست (تمیزترین حالت تک‌پستی)
POST_MODE=album

# حداکثر تعداد عکس در هر آلبوم (سقف تلگرام: ۱۰)
MAX_IMAGES_PER_POST=6

# ---- دیوار ----
# کد شهر: 1=تهران، 2=کرج، 3=مشهد، 4=اصفهان، 5=شیراز، 6=تبریز
DIVAR_CITY_CODE=1

# دسته‌بندی (موتورسیکلت)
DIVAR_CATEGORY=motorcycles

# حداکثر تعداد آگهی جدید در هر اجرا (برای اسپم نشدن کانال و بلاک نشدن)
MAX_POSTS_PER_RUN=10

# فاصله بین هر پست (ثانیه)
DELAY_BETWEEN_POSTS_SECONDS=30
